{
  "name": "dsh-temporary-session",
  "description": "Configurable temporary Workspace for isolated scratch Sessions in DeepSeek Harness",
  "version": "0.1.0-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "license": "MIT",
  "dsh": {
    "inventory": {
      "summary": {
        "zh": "提供可配置的临时工作区，把一次性会话与项目隔离并统一收纳。",
        "en": "Provides one configurable temporary Workspace that isolates and groups scratch Sessions."
      },
      "tags": [
        "session",
        "temporary",
        "workspace",
        "productivity"
      ],
      "dependencies": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-host-directory-picker",
        "@deepseek-ai/dsh-settings",
        "@deepseek-ai/dsh-workspace"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "prepack": "pnpm --dir ../.. run build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-api-remotes": "catalog:",
    "@deepseek-ai/dsh-client-locale": "catalog:",
    "@deepseek-ai/dsh-client-runtime": "catalog:",
    "@deepseek-ai/dsh-client-ui-sidebar": "catalog:",
    "@deepseek-ai/dsh-client-ui-settings": "catalog:",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "catalog:",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:",
    "@deepseek-ai/dsh-home-paths": "catalog:",
    "@deepseek-ai/dsh-host-directory-picker": "catalog:",
    "@deepseek-ai/dsh-invariants": "catalog:",
    "@deepseek-ai/dsh-settings": "catalog:",
    "@deepseek-ai/dsh-typert-protocol": "catalog:",
    "@deepseek-ai/dsh-workspace": "catalog:",
    "react": "catalog:"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
